<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Só o nuget.org: os pacotes Demo do FastReport estão lá, e o feed da Fast Reports
       (nuget.fast-report.com) pede login e devolve 403 no restore. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
